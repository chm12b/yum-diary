# Copy this file to `.env.local` and fill in values.

# Supabase — Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin for invite links, share URLs, and auth redirects
# (e.g. password reset → {APP_URL}/reset-password). No trailing slash.
# Example: https://yum-diary.vercel.app
# If unset, the browser falls back to window.location.origin.
NEXT_PUBLIC_APP_URL=

# Google Maps Platform — Places API (New)
# https://console.cloud.google.com/google/maps-apis/credentials
# Server-only. Never expose with NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=

# Google Cloud — Cloud Vision API (Menu OCR)
# Optional. When unset, Vision falls back to GOOGLE_MAPS_API_KEY if that key
# is on the same GCP project and has Cloud Vision API enabled.
# https://console.cloud.google.com/apis/library/vision.googleapis.com
# Server-only. Never expose with NEXT_PUBLIC_.
GOOGLE_CLOUD_API_KEY=

# OpenAI — AI Menu Parser PoC (Responses API)
# https://platform.openai.com/api-keys
# Server-only. Never expose with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.5-mini when unset.
# Examples: gpt-5.5-mini, gpt-5.5
OPENAI_MENU_PARSER_MODEL=
